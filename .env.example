# Independent PostgreSQL/Neon database used only by the portal login.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional public URL used in metadata. Vercel supplies its own deployment URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORTAL_REGISTRATION_ENABLED="false"

# AnaliseEQUIPA SSO pilot. Use the same long random secret in both deployments.
ANALISE_EQUIPA_URL="http://localhost:3001"
SSO_ANALISE_EQUIPA_CLIENT_SECRET="generate-a-long-random-secret"

# Ecosystem links. TACTIDRAW_URL and LIVE_TRAINING_URL already have safe defaults.
TACTIDRAW_URL="https://draw-analysis.vercel.app"
GAMEPLAN_URL=""
GAME_REVIEW_URL=""
WRITTEN_REPORT_URL=""
LIVE_GAME_URL="https://live-game-lilac.vercel.app"
LIVE_TRAINING_URL="https://livetraining-brun4fers-projects.vercel.app"
ACTION_MAP_URL="https://football-our-players-yavn.vercel.app"
OPPONENT_PLAYERS_URL="https://ap-opponent-players.vercel.app"
INDIVIDUAL_WRITTEN_REPORT_URL="https://ap-individual-written-report.vercel.app"
OPPONENT_PLAYER_VIDEO_ANALYSIS_URL="https://ap-opponent-player-video-analysis.vercel.app"
OUR_PLAYER_PERFORMANCE_REPORT_URL="https://ap-our-player-performance-report.vercel.app"
OUR_PLAYER_VIDEO_ANALYSIS_URL="https://ap-our-player-video-analysis.vercel.app"
COLLECTIVE_TRAINING_VIDEO_ANALYSIS_URL="https://ap-collective-training-video-analys.vercel.app"
